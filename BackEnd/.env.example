# Copie este arquivo para ".env" (na mesma pasta) e ajuste os valores.
# NUNCA envie o arquivo .env para o GitHub.

# Chave usada para assinar os tokens de login (JWT).
# Gere uma com:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Banco de dados. Se ficar vazio, usa o arquivo BackEnd/recloset.db (SQLite).
# Exemplo MySQL:  mysql+pymysql://usuario:senha@localhost/recloset
DATABASE_URL=

# Por quantos minutos o login continua válido.
TOKEN_EXPIRA_MINUTOS=120

# Por quantos minutos o link de "Esqueci minha senha" continua válido.
TOKEN_SENHA_EXPIRA_MINUTOS=30

# Endereço do site (usado no link de redefinição de senha).
URL_SITE=http://localhost:8000

# Valor fixo da entrega (frete) por pedido, em reais.
VALOR_ENTREGA=15.00

# Tamanho máximo de cada imagem enviada (MB).
TAMANHO_MAX_IMAGEM_MB=5

# Endereços de onde o frontend pode chamar a API quando NÃO é aberto
# pelo próprio FastAPI (ex.: Live Server do VS Code). Separe por vírgula.
CORS_ORIGENS=http://127.0.0.1:5500,http://localhost:5500
